<?xml version="1.0" encoding="utf-8"?>
<!-- The inputs can contain WIFI passwords, so they never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="inktap.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="inktap.xml" />
    </device-transfer>
</data-extraction-rules>
